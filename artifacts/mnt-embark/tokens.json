{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "MNT Embark Design System tokens. Dark-first luxury travel brand. Primary = warm gold, surfaces = near-black, text = warm ivory. Edit values here only — never hand-edit src/index.css or src/generated/tokens.tsx.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#FAF7F0", "$description": "Warm ivory page background" },
      "foreground": { "$value": "#1A1612", "$description": "Near-black warm text" },
      "border": { "$value": "#DDD5C0" },
      "card": { "$value": "#FFFFFF" },
      "cardForeground": { "$value": "#1A1612" },
      "popover": { "$value": "#FFFFFF" },
      "popoverForeground": { "$value": "#1A1612" },
      "primary": {
        "$value": "#A8832A",
        "$description": "Deep warm gold — primary brand color for buttons and key actions (darkened for light-mode contrast)."
      },
      "primaryForeground": { "$value": "#FAF7F0" },
      "secondary": { "$value": "#F5EFE2", "$description": "Warm parchment surface" },
      "secondaryForeground": { "$value": "#1A1612" },
      "muted": { "$value": "#F0EAD8" },
      "mutedForeground": { "$value": "#7A6B52" },
      "accent": { "$value": "#C9A84C", "$description": "Signature gold accent" },
      "accentForeground": { "$value": "#1A1612" },
      "destructive": { "$value": "#C0392B" },
      "destructiveForeground": { "$value": "#FAF7F0" },
      "input": { "$value": "#DDD5C0" },
      "ring": { "$value": "#A8832A" },
      "chart1": { "$value": "#A8832A" },
      "chart2": { "$value": "#8B7355" },
      "chart3": { "$value": "#C9A84C" },
      "chart4": { "$value": "#6B5A3E" },
      "chart5": { "$value": "#D4AA55" },
      "sidebar": { "$value": "#F5EFE2" },
      "sidebarForeground": { "$value": "#1A1612" },
      "sidebarBorder": { "$value": "#DDD5C0" },
      "sidebarPrimary": { "$value": "#A8832A" },
      "sidebarPrimaryForeground": { "$value": "#FAF7F0" },
      "sidebarAccent": { "$value": "#EDE3CC" },
      "sidebarAccentForeground": { "$value": "#1A1612" },
      "sidebarRing": { "$value": "#A8832A" }
    },
    "dark": {
      "background": { "$value": "#0A0908", "$description": "Near-black warm — primary site surface" },
      "foreground": { "$value": "#F2EAD3", "$description": "Warm ivory/cream text" },
      "border": { "$value": "#2E2820" },
      "card": { "$value": "#141210", "$description": "Slightly lifted dark surface" },
      "cardForeground": { "$value": "#F2EAD3" },
      "popover": { "$value": "#1C1916" },
      "popoverForeground": { "$value": "#F2EAD3" },
      "primary": {
        "$value": "#C9A84C",
        "$description": "Signature warm gold — the brand's defining color."
      },
      "primaryForeground": { "$value": "#0A0908" },
      "secondary": { "$value": "#2A2520", "$description": "Deep charcoal secondary surface" },
      "secondaryForeground": { "$value": "#F2EAD3" },
      "muted": { "$value": "#1E1B17" },
      "mutedForeground": { "$value": "#9C8B6E", "$description": "Muted warm gold-tan" },
      "accent": { "$value": "#D4AA55", "$description": "Lighter gold accent for highlights" },
      "accentForeground": { "$value": "#0A0908" },
      "destructive": { "$value": "#9B2335" },
      "destructiveForeground": { "$value": "#F2EAD3" },
      "input": { "$value": "#2E2820" },
      "ring": { "$value": "#C9A84C", "$description": "Gold focus ring" },
      "chart1": { "$value": "#C9A84C" },
      "chart2": { "$value": "#8B7355" },
      "chart3": { "$value": "#E8C97A" },
      "chart4": { "$value": "#6B5A3E" },
      "chart5": { "$value": "#A08B6A" },
      "sidebar": { "$value": "#100E0C", "$description": "Deeper than background — sidebar surface" },
      "sidebarForeground": { "$value": "#F2EAD3" },
      "sidebarBorder": { "$value": "#2E2820" },
      "sidebarPrimary": { "$value": "#C9A84C" },
      "sidebarPrimaryForeground": { "$value": "#0A0908" },
      "sidebarAccent": { "$value": "#2A2520" },
      "sidebarAccentForeground": { "$value": "#C9A84C" },
      "sidebarRing": { "$value": "#C9A84C" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Montserrat", "sans-serif"],
        "$description": "Body and UI typeface. Refined, geometric, legible."
      },
      "serif": {
        "$value": ["Cormorant Garamond", "Georgia", "serif"],
        "$description": "Display and headline typeface. Elegant, high-contrast, luxurious."
      },
      "mono": {
        "$value": ["JetBrains Mono", "monospace"],
        "$description": "Code and technical content."
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Very low base radius — 4px. Keeps forms and buttons crisp and architectural, not playful."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step."
    }
  }
}
