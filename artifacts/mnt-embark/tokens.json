{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "MNT Embark Design System tokens. Light-first luxury travel brand. Primary = deep warm gold, surfaces = cool white-blue, text = deep blue-black. Edit values here only — never hand-edit src/index.css or src/generated/tokens.tsx.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#F4F8FB", "$description": "Cool white page background with a quiet blue tint" },
      "foreground": { "$value": "#17212B", "$description": "Deep blue-black text for light surfaces" },
      "border": { "$value": "#D7E2EA" },
      "card": { "$value": "#FFFFFF" },
      "cardForeground": { "$value": "#17212B" },
      "popover": { "$value": "#FFFFFF" },
      "popoverForeground": { "$value": "#17212B" },
      "primary": {
        "$value": "#8F6D1E",
        "$description": "Deeper warm gold for contrast on cool white surfaces."
      },
      "primaryForeground": { "$value": "#F4F8FB" },
      "secondary": { "$value": "#EAF2F7", "$description": "Soft blue-white secondary surface" },
      "secondaryForeground": { "$value": "#17212B" },
      "muted": { "$value": "#E6EFF5" },
      "mutedForeground": { "$value": "#5D6C78" },
      "accent": { "$value": "#C9A84C", "$description": "Signature gold accent retained for text and details over dark imagery" },
      "accentForeground": { "$value": "#17212B" },
      "destructive": { "$value": "#C0392B" },
      "destructiveForeground": { "$value": "#F4F8FB" },
      "input": { "$value": "#D7E2EA" },
      "ring": { "$value": "#8F6D1E" },
      "chart1": { "$value": "#8F6D1E" },
      "chart2": { "$value": "#687C8C" },
      "chart3": { "$value": "#B18A2B" },
      "chart4": { "$value": "#425463" },
      "chart5": { "$value": "#C3A24D" },
      "sidebar": { "$value": "#EAF2F7" },
      "sidebarForeground": { "$value": "#17212B" },
      "sidebarBorder": { "$value": "#D7E2EA" },
      "sidebarPrimary": { "$value": "#8F6D1E" },
      "sidebarPrimaryForeground": { "$value": "#F4F8FB" },
      "sidebarAccent": { "$value": "#DDEAF2" },
      "sidebarAccentForeground": { "$value": "#17212B" },
      "sidebarRing": { "$value": "#8F6D1E" }
    },
    "dark": {
      "background": { "$value": "#0A0908", "$description": "Near-black warm — primary site surface" },
      "foreground": { "$value": "#F2EAD3", "$description": "Warm ivory/cream text" },
      "border": { "$value": "#2E2820" },
      "card": { "$value": "#141210", "$description": "Slightly lifted dark surface" },
      "cardForeground": { "$value": "#F2EAD3" },
      "popover": { "$value": "#1C1916" },
      "popoverForeground": { "$value": "#F2EAD3" },
      "primary": {
        "$value": "#C9A84C",
        "$description": "Signature warm gold — the brand's defining color."
      },
      "primaryForeground": { "$value": "#0A0908" },
      "secondary": { "$value": "#2A2520", "$description": "Deep charcoal secondary surface" },
      "secondaryForeground": { "$value": "#F2EAD3" },
      "muted": { "$value": "#1E1B17" },
      "mutedForeground": { "$value": "#9C8B6E", "$description": "Muted warm gold-tan" },
      "accent": { "$value": "#D4AA55", "$description": "Lighter gold accent for highlights" },
      "accentForeground": { "$value": "#0A0908" },
      "destructive": { "$value": "#9B2335" },
      "destructiveForeground": { "$value": "#F2EAD3" },
      "input": { "$value": "#2E2820" },
      "ring": { "$value": "#C9A84C", "$description": "Gold focus ring" },
      "chart1": { "$value": "#C9A84C" },
      "chart2": { "$value": "#8B7355" },
      "chart3": { "$value": "#E8C97A" },
      "chart4": { "$value": "#6B5A3E" },
      "chart5": { "$value": "#A08B6A" },
      "sidebar": { "$value": "#100E0C", "$description": "Deeper than background — sidebar surface" },
      "sidebarForeground": { "$value": "#F2EAD3" },
      "sidebarBorder": { "$value": "#2E2820" },
      "sidebarPrimary": { "$value": "#C9A84C" },
      "sidebarPrimaryForeground": { "$value": "#0A0908" },
      "sidebarAccent": { "$value": "#2A2520" },
      "sidebarAccentForeground": { "$value": "#C9A84C" },
      "sidebarRing": { "$value": "#C9A84C" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Montserrat", "sans-serif"],
        "$description": "Body and UI typeface. Refined, geometric, legible."
      },
      "serif": {
        "$value": ["Cormorant Garamond", "Georgia", "serif"],
        "$description": "Display and headline typeface. Elegant, high-contrast, luxurious."
      },
      "mono": {
        "$value": ["JetBrains Mono", "monospace"],
        "$description": "Code and technical content."
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Very low base radius — 4px. Keeps forms and buttons crisp and architectural, not playful."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step."
    }
  }
}
