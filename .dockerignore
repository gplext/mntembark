# Keep the build context small — anything not needed to build the app.

# Dependencies and build output (rebuilt inside the image)
node_modules
**/node_modules
dist
**/dist
build
**/build
.pnpm-store
*.tsbuildinfo

# VCS and CI
.git
.gitignore
.github

# Editors / OS noise
.vscode
.idea
.DS_Store
Thumbs.db
*.swp

# Local env — never bake secrets into an image
.env
.env.*
!.env.example

# Docs and design-system preview material that the runtime never needs
*.md
!README.md
attached_assets
artifacts/mnt-embark/docs

# Large archives / media that should never enter an image
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
*.mp4
*.mov
*.psd
*.ai
*.sketch
*.fig

# Logs and caches
*.log
npm-debug.log*
coverage
.cache
tmp

# Replit leftovers (should already be deleted, belt and braces)
.replit
.replitignore
replit.md
.agents
.local
.config
