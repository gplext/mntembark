# ---------------------------------------------------------------------------
# MNT Embark — environment variables
# Copy to .env for local development.
# ---------------------------------------------------------------------------

# Postgres connection string. Required.
# Local development (embedded compose DB): postgres://mnt:changeme@localhost:5432/mnt_embark
# Coolify standalone DB resource: postgres://<user>:<password>@<coolify-db-host>:5432/<dbname>
DATABASE_URL=postgres://mnt:changeme@localhost:5432/mnt_embark

# Secret used to sign session cookies and upload URLs. Required.
SESSION_SECRET=secret_key_change_me_in_production

# Password for the /admin panel login. Required.
ADMIN_PASSWORD=admin123

# Port the server listens on.
PORT=8080


# Compose profiles for local development with embedded DB
# Uncomment the line below to automatically include the 'db' container locally:
# COMPOSE_PROFILES=with-db


# ---------------------------------------------------------------------------
# WhatsApp, through Meta's Cloud API. Optional — the site takes enquiries
# unchanged without it.
#
# Messages a business starts must use a template Meta approved in advance, so
# these two have to exist in your WhatsApp Manager before anything sends. The
# wording is fixed by Meta; only the {{1}}, {{2}}... values come from the site,
# and the ORDER below is the contract:
#
#   enquiry_confirmation (to the client)
#     "Hi {{1}}, thank you for your enquiry about {{2}}. Someone from {{3}}
#      will be in touch personally, usually within one working day."
#
#   enquiry_alert (to you)
#     "New {{1}} enquiry from {{2}} ({{3}}) about {{4}}."
#
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# Your own numbers, E.164, comma-separated:
# WHATSAPP_NOTIFY_NUMBERS=+441234567890
# WHATSAPP_CLIENT_TEMPLATE=enquiry_confirmation
# WHATSAPP_ADMIN_TEMPLATE=enquiry_alert
# WHATSAPP_TEMPLATE_LANGUAGE=en
#
# Country code for numbers visitors type in local form ("0300 1234567").
# Set it to where most of your visitors are; anyone abroad should type the +.
# Without it, only numbers written with a + can be messaged.
# DEFAULT_PHONE_COUNTRY_CODE=92
