# ---------------------------------------------------------------------------
# MNT Embark — environment variables
# Copy to .env for local development. In Coolify, set these as app env vars.
# ---------------------------------------------------------------------------

# Postgres connection string. Required.
DATABASE_URL=postgres://user:password@host:5432/mnt_embark

# Secret used to sign session cookies and upload URLs. Required.
# Generate one with:  openssl rand -hex 32
SESSION_SECRET=

# Password for the /admin panel login. Required.
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Optional — sensible defaults are baked into the Docker image
# ---------------------------------------------------------------------------

# Port the server listens on.
PORT=8080

# Directory containing the built frontend (index.html + assets).
# PUBLIC_DIR=/app/public

# Persistent directory for admin-uploaded images. Mount a volume here.
# UPLOAD_DIR=/data/uploads

# Maximum upload size in bytes (default 25 MB).
# MAX_UPLOAD_BYTES=26214400

# Where the local embedding model is cached (persist to avoid re-downloading).
# MODEL_CACHE_DIR=/data/model-cache

# Dev only: the API server the Vite dev server proxies /api to.
# API_PROXY_TARGET=http://localhost:8080
